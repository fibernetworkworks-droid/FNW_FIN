                 remember(lookup.landlineNumber, ok = true, summary = "Converted (Quick) · ${resp.plan.ifBlank { plan.name }}", detail = lookup.customerName, ref = resp.orderNumber)
             }.onFailure { t ->
                 val isPonr = mayHaveBeenPlaced(t)
