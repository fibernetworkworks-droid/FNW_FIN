                 if (isSessionExpired) {
                     // Lovable's behavior: auto-refresh lookup, ask user to retry.
                     // Start the refresh FIRST: quickDoLookup clears quickSubmitError when it
@@ -979,6 +980,4 @@ class FtthConversionViewModel @Inject constructor(
     companion object {
         private fun normalizeLandline(input: String): String? = LandlineNumber.normalize(input)
     }
-}
-    }
 }
diff --git a/app/src/test/java/com/fnw/flow/operator/ui/screens/tools/ftth/FtthConversionEndToEndTest.kt b/app/src/test/java/com/fnw/flow/operator/ui/screens/tools/ftth/FtthConversionEndToEndTest.kt
index 3a2fb4a..510a292 100644
--- a/app/src/test/java/com/fnw/flow/operator/ui/screens/tools/ftth/FtthConversionEndToEndTest.kt
+++ b/app/src/test/java/com/fnw/flow/operator/ui/screens/tools/ftth/FtthConversionEndToEndTest.kt
@@ -454,6 +454,23 @@ class FtthConversionEndToEndTest {
         }
     }
 
+    @Test
+    fun quick_job_lookupExpiredCode_refreshesWhateverTheWording() {
+        backend.jobsEnabled = true
+        seedQuickLookup()
+        // The code decides, not the text: this message never says "lookup expired".
+        backend.startOutcome = 400 to """{"status":"FAILED","error":"Search the number again.","errorCode":"LOOKUP_EXPIRED"}"""
+        vm.quickDoConvert()
+        await("re-lookup fired") { backend.count("/api/ftth/lookup") == 2 && !it.quickLookupLoading }
+        assertEquals("Lookup refreshed. Please review and submit again.", vm.state.value.quickSubmitError)
+        assertFalse(vm.state.value.quickSubmitPonr)
+        awaitToast("session expired info") { it is FtthConversionViewModel.Toast.Info }
+
+        backend.startOutcome = null
+        vm.quickDoConvert()
+        await("converted") { it.quickResult != null }
+    }
+
     @Test
     fun quick_job_submittedBlocksAnotherConvert() {
         val placed = "The order was placed at BSNL, but BSNL was slow to confirm it. Its order number will appear in Order Tracking shortly. Do not submit this number again."
@@ -598,6 +615,8 @@ private class ScriptedConversionBackend : Dispatcher() {
     var convertOutcome: Pair<Int, String>? = null
     /** Off: the /start routes answer 404, as a server without automation/ftth-jobs.js does. */
     var jobsEnabled = false
+    /** When set, the /start routes answer this instead of STARTED. */
+    var startOutcome: Pair<Int, String>? = null
     /** What GET /api/ftth/job/{id} reports; null = done, with the order the started route would return. */
     var jobOutcome: String? = null
     var jobPollCode = 200
@@ -621,7 +640,7 @@ private class ScriptedConversionBackend : Dispatcher() {
         val path = request.path.orEmpty()
         if (path.startsWith("/api/ftth/") && path.endsWith("/start")) {
             return if (!jobsEnabled) raw(404, """{"error":"Cannot POST $path"}""")
-            else json("""{"status":"STARTED","jobId":"$JOB_ID","existing":false}""")
+            else startOutcome?.let { (c, b) -> raw(c, b) } ?: json("""{"status":"STARTED","jobId":"$JOB_ID","existing":false}""")
         }
         if (path.startsWith("/api/ftth/job/")) {
             if (jobPollCode != 200) return raw(jobPollCode, """{"ok":false,"error":"Job not found"}""")
