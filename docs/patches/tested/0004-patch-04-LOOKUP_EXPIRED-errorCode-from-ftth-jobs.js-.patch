 tools/ftth-robust-test.mjs                    |  1 +
 tools/ftth/ftth-jobs.js                       |  3 ++-
 6 files changed, 38 insertions(+), 6 deletions(-)

diff --git a/app/src/main/java/com/fnw/flow/operator/data/api/dto/FtthV3Dtos.kt b/app/src/main/java/com/fnw/flow/operator/data/api/dto/FtthV3Dtos.kt
index e0396df..f06c13c 100644
--- a/app/src/main/java/com/fnw/flow/operator/data/api/dto/FtthV3Dtos.kt
+++ b/app/src/main/java/com/fnw/flow/operator/data/api/dto/FtthV3Dtos.kt
@@ -307,6 +307,8 @@ data class V1ConvertResponse(
     val ponr: Boolean = false,
     val custOrderId: String? = null,
     val error: String? = null,
+    /** Machine-readable failure, e.g. "LOOKUP_EXPIRED"; absent from older servers. */
+    val errorCode: String? = null,
 )
 
 // ╔══════════════════════════════════════════════════════════════════════════╗
diff --git a/app/src/main/java/com/fnw/flow/operator/data/repository/FtthConversionRepository.kt b/app/src/main/java/com/fnw/flow/operator/data/repository/FtthConversionRepository.kt
index a5fe523..3aa866b 100644
--- a/app/src/main/java/com/fnw/flow/operator/data/repository/FtthConversionRepository.kt
+++ b/app/src/main/java/com/fnw/flow/operator/data/repository/FtthConversionRepository.kt
@@ -121,6 +121,7 @@ class FtthConversionRepository @Inject constructor(
                 message = body.error ?: "Conversion failed",
                 ponr = body.ponr,
                 custOrderId = body.custOrderId,
+                code = body.errorCode,
             )
             throw ex
         }
@@ -209,6 +210,7 @@ class FtthConversionRepository @Inject constructor(
         Timber.w("ftth job start HTTP ${resp.code()}: $raw")
         throw ConvertException(
             ErrorMapper.parseBackendError(raw) ?: body?.error ?: friendlyHttpError(resp.code(), action = "start the conversion"),
+            code = ERROR_CODE.find(raw)?.groupValues?.get(1),
         )
     }
 
@@ -282,6 +284,7 @@ class FtthConversionRepository @Inject constructor(
             error = ErrorMapper.parseBackendError(raw) ?: friendlyHttpError(resp.code(), action = "convert the connection"),
             ponr = PONR_TRUE.containsMatchIn(raw),
             custOrderId = CUST_ORDER_ID.find(raw)?.groupValues?.get(1),
+            errorCode = ERROR_CODE.find(raw)?.groupValues?.get(1),
         )
     }
 
@@ -303,6 +306,7 @@ class FtthConversionRepository @Inject constructor(
             "Check Order Tracking for this number before trying again."
         val PONR_TRUE = Regex(""""ponr"\s*:\s*true""")
         val CUST_ORDER_ID = Regex(""""custOrderId"\s*:\s*"([^"]+)"""")
+        val ERROR_CODE = Regex(""""errorCode"\s*:\s*"([^"]+)"""")
     }
 
     private inline fun <T> wrap(label: String, block: () -> T): Result<T> =
@@ -318,6 +322,12 @@ class FtthConversionRepository @Inject constructor(
         val custOrderId: String? = null,
         /** BSNL may have taken the order (it was slow to confirm, or we lost track): never retry blindly. */
         val uncertain: Boolean = false,
-    ) : Exception(message)
+        /** The server's machine-readable `errorCode`, e.g. [LOOKUP_EXPIRED]; null from older servers. */
+        val code: String? = null,
+    ) : Exception(message) {
+        companion object {
+            const val LOOKUP_EXPIRED = "LOOKUP_EXPIRED"
+        }
+    }
 }
 
diff --git a/app/src/main/java/com/fnw/flow/operator/ui/screens/tools/ftth/FtthConversionViewModel.kt b/app/src/main/java/com/fnw/flow/operator/ui/screens/tools/ftth/FtthConversionViewModel.kt
