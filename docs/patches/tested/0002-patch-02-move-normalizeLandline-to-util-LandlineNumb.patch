+++ b/app/src/main/java/com/fnw/flow/operator/util/LandlineNumber.kt
@@ -0,0 +1,19 @@
+package com.fnw.flow.operator.util
+
+/** Indian landline numbers as the FTTH conversion screens take them. */
+object LandlineNumber {
+    /**
+     * The canonical "0XXXXXXXXXX" form, or null when [input] is not a landline.
+     * Accepts all Indian formats - 2-5 digit STD codes, optional dashes/spaces/+91.
+     */
+    fun normalize(input: String): String? {
+        val digits = input.filter { it.isDigit() }
+        return when {
+            digits.length == 10 -> "0$digits"
+            digits.length == 11 && digits.startsWith("0") -> digits
+            digits.length == 12 && digits.startsWith("91") -> "0" + digits.substring(2)
+            digits.length == 13 && digits.startsWith("091") -> "0" + digits.substring(3)
+            else -> null
+        }
+    }
+}
diff --git a/app/src/test/java/com/fnw/flow/operator/util/LandlineNumberTest.kt b/app/src/test/java/com/fnw/flow/operator/util/LandlineNumberTest.kt
new file mode 100644
index 0000000..438f83a
--- /dev/null
+++ b/app/src/test/java/com/fnw/flow/operator/util/LandlineNumberTest.kt
@@ -0,0 +1,25 @@
+package com.fnw.flow.operator.util
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class LandlineNumberTest {
+
+    @Test fun acceptsTheWaysOperatorsTypeANumber() {
+        for (typed in listOf(
+            "07242459222", "0724-2459222", "0724 245 9222", "7242459222",
+            "+91 724 2459222", "917242459222", "091-724-2459222",
+        )) assertEquals(typed, "07242459222", LandlineNumber.normalize(typed))
+    }
+
+    @Test fun keepsShortAndLongStdCodes() {
+        assertEquals("02224567890", LandlineNumber.normalize("022-24567890"))
+        assertEquals("07172234567", LandlineNumber.normalize("07172-234567"))
+    }
+
+    @Test fun rejectsWhatIsNotALandline() {
+        for (typed in listOf("", "12345", "724245922", "17242459222", "0724245922299", "927242459222"))
+            assertNull(typed, LandlineNumber.normalize(typed))
+    }
+}
